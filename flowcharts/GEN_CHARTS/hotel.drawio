        <mxCell id="n7" value="hotel is not None" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#000000;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#000000;shape=mxgraph.flowchart.decision;fontStyle=1;" vertex="1" parent="1">
