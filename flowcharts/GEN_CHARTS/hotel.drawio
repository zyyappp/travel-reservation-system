          <mxGeometry x="650" y="370" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="not valid_date" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#000000;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#000000;shape=mxgraph.flowchart.decision;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="470" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="INPUT start_input, end_input" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#000000;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#000000;shape=parallelogram;perimeter=parallelogramPerimeter;" vertex="1" parent="1">
          <mxGeometry x="650" y="620" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="not start_input or not end_input" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#000000;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#000000;shape=mxgraph.flowchart.decision;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="720" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="start = datetime.strptime(start_input, &quot;%d/%m/%Y&quot;).date()" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#000000;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#000000;shape=process;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="870" width="400" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="end = datetime.strptime(end_input, &quot;%d/%m/%Y&quot;).date()" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#000000;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#000000;shape=process;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="970" width="400" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="(datetime.now().date() - start).days &gt; 0 or (datetime.now().date() - end).days &gt; 0" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#000000;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#000000;shape=mxgraph.flowchart.decision;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="1070" width="340" height="105" as="geometry" />
