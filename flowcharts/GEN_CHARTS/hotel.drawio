  <diagram name="09 — reserve_hotel(user_id): reservation finalization" id="09___reserve_hotel_user_id___reservation_finalization">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="09 — reserve_hotel(user_id): reservation finalization" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="20" y="18" width="1560" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="4" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#000000;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#000000;shape=offPageConnector;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="70" width="300" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="current_page == &quot;reserved&quot;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#000000;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#000000;shape=mxgraph.flowchart.decision;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="200" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="guest_multiplier = 0.364 * math.log(room_list.index(room_type) + 1) + 1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#000000;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#000000;shape=process;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="335" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="net_total = round(guest_multiplier * hotel_details[&quot;price&quot;] * num_rooms * nights, 2)" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#000000;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#000000;shape=process;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="435" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="reserve_details = formatted reservation details" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#000000;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#000000;shape=process;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="535" width="340" height="55" as="geometry" />
