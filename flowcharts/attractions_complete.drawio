<mxCell id="p3h" parent="p3_r" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;" value="PRINT print_header(&quot;ATTRACTION RESERVATION PERIOD&quot;)" vertex="1"><mxGeometry height="60" width="440" x="210" y="140" as="geometry" /></mxCell>
<mxCell id="p3v" parent="p3_r" style="rounded=0;whiteSpace=wrap;html=1;" value="valid_date = False" vertex="1"><mxGeometry height="60" width="260" x="300" y="240" as="geometry" /></mxCell>
<mxCell id="p3w" parent="p3_r" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;" value="not valid_date" vertex="1"><mxGeometry height="80" width="220" x="315" y="340" as="geometry" /></mxCell>
<mxCell id="p3in" parent="p3_r" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;" value="INPUT start_input = input(&quot;Enter start date (DD/MM/YYYY) &gt;&gt; &quot;)
INPUT end_input = input(&quot;Enter end date (DD/MM/YYYY) &gt;&gt; &quot;)" vertex="1"><mxGeometry height="80" width="540" x="155" y="460" as="geometry" /></mxCell>
<mxCell id="p3empty" parent="p3_r" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;" value="start_input == &quot;&quot; or end_input == &quot;&quot;" vertex="1"><mxGeometry height="80" width="250" x="300" y="580" as="geometry" /></mxCell>
<mxCell id="p3none" parent="p3_r" style="rounded=1;whiteSpace=wrap;html=1;" value="return None" vertex="1"><mxGeometry height="60" width="160" x="610" y="590" as="geometry" /></mxCell>
<mxCell id="p3parse" parent="p3_r" style="rounded=0;whiteSpace=wrap;html=1;" value="start = datetime.strptime(start_input, &quot;%d/%m/%Y&quot;).date()
end = datetime.strptime(end_input, &quot;%d/%m/%Y&quot;).date()" vertex="1"><mxGeometry height="80" width="520" x="130" y="700" as="geometry" /></mxCell>
<mxCell id="p3past" parent="p3_r" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;" value="(datetime.now().date() - start).days &gt; 0 or (datetime.now().date() - end).days &gt; 0" vertex="1"><mxGeometry height="80" width="300" x="280" y="830" as="geometry" /></mxCell>
<mxCell id="p3pastmsg" parent="p3_r" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;" value="PRINT &quot;Reservation date cannot be before the current date.&quot;
continue" vertex="1"><mxGeometry height="70" width="350" x="620" y="840" as="geometry" /></mxCell>
<mxCell id="p3bad" parent="p3_r" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;" value="PRINT &quot;Invalid date. Try again.&quot;
continue  # except ValueError" vertex="1"><mxGeometry height="70" width="280" x="0" y="710" as="geometry" /></mxCell>
<mxCell id="p3days" parent="p3_r" style="rounded=0;whiteSpace=wrap;html=1;" value="days = (end - start).days +1" vertex="1"><mxGeometry height="60" width="260" x="300" y="980" as="geometry" /></mxCell>
<mxCell id="p3neg" parent="p3_r" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;" value="days &lt; 0" vertex="1"><mxGeometry height="80" width="220" x="320" y="1090" as="geometry" /></mxCell>
<mxCell id="p3negmsg" parent="p3_r" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;" value="PRINT &quot;End date cannot be earlier than the start date.&quot;
continue" vertex="1"><mxGeometry height="70" width="380" x="580" y="1100" as="geometry" /></mxCell>
<mxCell id="p3zero" parent="p3_r" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;" value="days == 0" vertex="1"><mxGeometry height="80" width="220" x="320" y="1230" as="geometry" /></mxCell>
<mxCell id="p3zeromsg" parent="p3_r" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;" value="PRINT &quot;Day difference cannot be 0&quot;
continue" vertex="1"><mxGeometry height="70" width="330" x="580" y="1240" as="geometry" /></mxCell>
<mxCell id="p3ret" parent="p3_r" style="rounded=1;whiteSpace=wrap;html=1;" value="return start, end, start_input, end_input, days" vertex="1"><mxGeometry height="60" width="430" x="200" y="1370" as="geometry" /></mxCell>
