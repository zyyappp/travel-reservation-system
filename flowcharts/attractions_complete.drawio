<mxCell id="p10count" parent="p10_r" style="rounded=0;whiteSpace=wrap;html=1;" value="total_reservations = sum(len(v) for v in account[&quot;reservations&quot;].values()) + 1
PRINT print(&quot;\\nReserved!\\n&quot;)" vertex="1"><mxGeometry height="80" width="590" x="80" y="800" as="geometry" /></mxCell>
<mxCell id="p10append" parent="p10_r" style="rounded=0;whiteSpace=wrap;html=1;" value="account[&quot;reservations&quot;][&quot;attractions&quot;].append({&quot;reservation_id&quot;: total_reservations, &quot;name&quot;: attraction_name, &quot;city&quot;: account[&quot;city&quot;], &quot;category&quot;: attraction_category, &quot;start&quot;: str(start), &quot;end&quot;: str(end), &quot;days&quot;: days, &quot;price&quot;: float(attraction_price), &quot;pax&quot;: num_ppl, &quot;net_total&quot;: float(net_total), &quot;paid&quot;: False, &quot;expired&quot;: False})" vertex="1"><mxGeometry height="110" width="730" x="20" y="940" as="geometry" /></mxCell>
