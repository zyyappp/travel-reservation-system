<mxCell id="p10total" parent="p10_r" style="rounded=0;whiteSpace=wrap;html=1;" value="net_total = attraction_price * num_ppl * days" vertex="1"><mxGeometry height="60" width="350" x="250" y="240" as="geometry" /></mxCell>
<mxCell id="p10details" parent="p10_r" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;" value="PRINT final_details = f&quot;&quot;&quot;
{attraction_name.upper()}
{'─' * 60}

CATEGORY
{attraction_category}

ENTRY PRICE
RM {attraction_price:.2f} / pax

PERIOD
{start_input} - {end_input}

DAYS
{days} day(s)

PAX
{num_ppl} person(s)

NET TOTAL
RM {net_total:.2f}
{'─' * 60}
&quot;&quot;&quot;
PRINT print(final_details)" vertex="1"><mxGeometry height="330" width="690" x="80" y="350" as="geometry" /></mxCell>
<mxCell id="p10confirm" parent="p10_r" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;shapeInside=1;fixedSize=1;" value="INPUT confirm = select(&quot;Confirm reservation? &gt;&gt; &quot;, [&quot;Yes&quot;, &quot;No&quot;])" vertex="1"><mxGeometry height="60" width="530" x="160" y="730" as="geometry" /></mxCell>
<mxCell id="p10yes" parent="p10_r" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;" value="confirm == &quot;Yes&quot;" vertex="1"><mxGeometry height="80" width="220" x="315" y="850" as="geometry" /></mxCell>
