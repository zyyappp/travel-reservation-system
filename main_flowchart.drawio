        <mxCell id="init" value="menu_options = [...]&#xa;menu = True&#xa;redirect = {...}" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
