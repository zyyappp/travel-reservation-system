        <!-- ====== LOGIN ====== -->
        <mxCell id="login" value="user = login_user()" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
